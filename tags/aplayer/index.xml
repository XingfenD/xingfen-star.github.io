            <title>APlayer 音乐播放器示例</title>
            <link>https://xingfend.github.io/blog-by-hugo/post/aplayer-demo/</link>
            <pubDate>Sat, 13 Jun 2026 02:00:00 +0000</pubDate>
            <guid>https://xingfend.github.io/blog-by-hugo/post/aplayer-demo/</guid>
            <description>&lt;p&gt;本文展示了如何在博客中使用 APlayer 音乐播放器。&lt;/p&gt;&#xA;&lt;h2 id=&#34;实际演示&#34;&gt;实际演示&#xA;&lt;/h2&gt;&lt;p&gt;下面是一个真实的播放器示例（使用外部音频源）：&lt;/p&gt;&#xA;&lt;div id=&#34;aplayer-266f85db4453d98de0fa127f4d106ab1&#34; class=&#34;aplayer-container&#34;&gt;&lt;/div&gt;&#xA;&#xA;&lt;script&gt;&#xA;(function() {&#xA;  var el = document.getElementById(&#39;aplayer-266f85db4453d98de0fa127f4d106ab1&#39;);&#xA;  var audioUrl = &#39;\/blog-by-hugo\/music\/罗生门.mp3&#39;;&#xA;  var coverUrl = &#39;&#39;;&#xA;&#xA;  function createPlayer(url, cover) {&#xA;    if (typeof APlayer === &#39;undefined&#39;) {&#xA;      window.addEventListener(&#39;load&#39;, function() { createPlayer(url, cover); });&#xA;      return;&#xA;    }&#xA;    new APlayer({&#xA;      container: el,&#xA;      theme: &#39;#2980b9&#39;,&#xA;      audio: [{&#xA;        name: &#39;罗生门&#39;,&#xA;        artist: &#39;梨冻紧 Wiz_H张子豪&#39;,&#xA;        url: url,&#xA;        cover: cover || &#39;&#39;,&#xA;        lrc: &#39;&#39;&#xA;      }],&#xA;      autoplay:  false ,&#xA;      lrcType: 0&#xA;    });&#xA;  }&#xA;&#xA;  function init() {&#xA;    if (coverUrl) {&#xA;      createPlayer(audioUrl, coverUrl);&#xA;      return;&#xA;    }&#xA;    if (typeof jsmediatags === &#39;undefined&#39;) {&#xA;      window.addEventListener(&#39;load&#39;, init);&#xA;      return;&#xA;    }&#xA;    fetch(encodeURI(audioUrl))&#xA;      .then(function(r) { return r.arrayBuffer(); })&#xA;      .then(function(buffer) {&#xA;        var blobUrl = URL.createObjectURL(new Blob([buffer]));&#xA;        jsmediatags.read(new Blob([buffer]), {&#xA;          onSuccess: function(tag) {&#xA;            var pic = tag.tags &amp;&amp; tag.tags.picture;&#xA;            if (!pic) { createPlayer(blobUrl, &#39;&#39;); return; }&#xA;            var base64 = &#39;&#39;;&#xA;            for (var i = 0; i &lt; pic.data.length; i++) {&#xA;              base64 += String.fromCharCode(pic.data[i]);&#xA;            }&#xA;            createPlayer(blobUrl, &#39;data:&#39; + pic.format + &#39;;base64,&#39; + btoa(base64));&#xA;          },&#xA;          onError: function() { createPlayer(blobUrl, &#39;&#39;); }&#xA;        });&#xA;      })&#xA;      .catch(function() { createPlayer(audioUrl, &#39;&#39;); });&#xA;  }&#xA;&#xA;  if (&#39;IntersectionObserver&#39; in window) {&#xA;    var observer = new IntersectionObserver(function(entries) {&#xA;      if (entries[0].isIntersecting) {&#xA;        observer.disconnect();&#xA;        init();&#xA;      }&#xA;    }, { rootMargin: &#39;200px&#39; });&#xA;    observer.observe(el);&#xA;  } else {&#xA;    document.addEventListener(&#39;DOMContentLoaded&#39;, init);&#xA;  }&#xA;})();&#xA;&lt;/script&gt;&#xA;&#xA;&lt;style&gt;&#xA;.aplayer-container {&#xA;  margin: 1rem 0;&#xA;}&#xA;&lt;/style&gt;&#xA;&#xA;&lt;h2 id=&#34;基础用法&#34;&gt;基础用法&#xA;&lt;/h2&gt;&lt;p&gt;最简单的用法，只需要提供歌曲名和音频地址：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;歌曲名&amp;#34; artist=&amp;#34;艺术家&amp;#34; url=&amp;#34;音频地址&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;本地资源page-bundle&#34;&gt;本地资源（Page Bundle）&#xA;&lt;/h2&gt;&lt;p&gt;把音频文件和博文放在同一个目录下：&lt;/p&gt;&#xA;&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;content/post/your-post/&#xA;├── index.md&#xA;├── forest.mp3        ← 音频文件&#xA;├── cover.jpg         ← 封面图片&#xA;└── song.lrc          ← 歌词文件&#xA;&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;使用相对路径引用：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;森林之声&amp;#34; artist=&amp;#34;大自然&amp;#34; url=&amp;#34;forest.mp3&amp;#34; cover=&amp;#34;cover.jpg&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;外部网络资源&#34;&gt;外部网络资源&#xA;&lt;/h2&gt;&lt;p&gt;直接使用完整的 URL 地址：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;示例音乐&amp;#34; artist=&amp;#34;艺术家&amp;#34; url=&amp;#34;https://example.com/music.mp3&amp;#34; cover=&amp;#34;https://example.com/cover.jpg&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;带歌词的播放器&#34;&gt;带歌词的播放器&#xA;&lt;/h2&gt;&lt;p&gt;支持 LRC 格式的歌词文件：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;歌曲&amp;#34; artist=&amp;#34;歌手&amp;#34; url=&amp;#34;song.mp3&amp;#34; lrc=&amp;#34;song.lrc&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;自定义样式&#34;&gt;自定义样式&#xA;&lt;/h2&gt;&lt;p&gt;可以自定义主题颜色：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;红色主题&amp;#34; artist=&amp;#34;艺术家&amp;#34; url=&amp;#34;music.mp3&amp;#34; theme=&amp;#34;&lt;span class=&#34;ni&#34;&gt;#e74c3c&lt;/span&gt;&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;自动播放&#34;&gt;自动播放&#xA;&lt;/h2&gt;&lt;p&gt;设置 &lt;code&gt;autoplay=&amp;quot;true&amp;quot;&lt;/code&gt; 让音乐自动播放（注意：大多数浏览器会阻止自动播放）：&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;&#xA;&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;lntd&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;{{&amp;lt; aplayer name=&amp;#34;背景音乐&amp;#34; artist=&amp;#34;轻音乐&amp;#34; url=&amp;#34;bgm.mp3&amp;#34; autoplay=&amp;#34;true&amp;#34; &amp;gt;}}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&lt;h2 id=&#34;完整参数&#34;&gt;完整参数&#xA;&lt;/h2&gt;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;参数&lt;/th&gt;&#xA;          &lt;th&gt;说明&lt;/th&gt;&#xA;          &lt;th&gt;默认值&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;name&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;歌曲名&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;Unknown&lt;/code&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;artist&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;艺术家&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;Unknown&lt;/code&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;url&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;音频文件路径&lt;/td&gt;&#xA;          &lt;td&gt;必填&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;cover&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;封面图片&lt;/td&gt;&#xA;          &lt;td&gt;空&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;lrc&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;歌词文件&lt;/td&gt;&#xA;          &lt;td&gt;空&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;theme&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;主题色&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;#2980b9&lt;/code&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;autoplay&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;自动播放&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;false&lt;/code&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;id&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;自定义 ID&lt;/td&gt;&#xA;          &lt;td&gt;自动生成&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;注意事项&#34;&gt;注意事项&#xA;&lt;/h2&gt;&lt;ol&gt;&#xA;&lt;li&gt;&lt;strong&gt;音频格式&lt;/strong&gt;：推荐使用 MP3 格式，兼容性最好&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;文件大小&lt;/strong&gt;：本地音频文件不要太大，建议压缩后小于 5MB&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;版权问题&lt;/strong&gt;：使用外部资源时请注意版权&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;自动播放&lt;/strong&gt;：现代浏览器通常会阻止自动播放，用户需要先与页面交互&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;h2 id=&#34;更多资源&#34;&gt;更多资源&#xA;&lt;/h2&gt;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://aplayer.js.org/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;&#xA;    &gt;APlayer 官方文档&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/DIYgod/APlayer&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;&#xA;    &gt;APlayer GitHub&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;</description>
        </item></channel>
